project_id                 = "your-gcp-project-id"
project_number             = "123456789012"
region                     = "us-central1"
zone                       = "us-central1-c"
prefix                     = "apf"
display_name_prefix        = "Agentic Foundry"
domain_name                = "foundry.example.com"
cloud_run_ui_service_name  = "apf-ui"
cloud_run_api_service_name = "apf-api"
cloud_run_ai_service_name  = "apf-ai"
iap_client_id              = "your-iap-client-id.apps.googleusercontent.com"
iap_allowed_members        = ["domain:example.com"]

subnet_range           = "10.10.0.0/24"
secondary_subnet_range = "192.168.0.0/24"
vpc_connector_range    = "10.10.1.0/28"

manage_public_dns_zone      = false
public_dns_zone_name_to_use = "example-com-zone"
