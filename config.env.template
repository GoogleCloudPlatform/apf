# Master Environment Configuration Template (Single Source of Truth)
# Copied to config.env by scripts/setup_env.sh during initial mise run env-setup

# Google Cloud & Infrastructure
GOOGLE_CLOUD_PROJECT=your-gcp-project-id    # Ask User
GOOGLE_CLOUD_LOCATION=                      # Ask User
GCS_ARTIFACT_BUCKET=your-artifact-bucket    # Ask User

# Firebase / Firestore
FIRESTORE_EMULATOR_HOST=localhost:8084
FIRESTORE_DB_NAME=apf-local-firestore

# AI Service Configuration (ai/)
GEMINI_API_KEY=                             # Ask User
SERVICE_NAME=apf
AGENT_LOADER_NAME=super
ARTIFACT_SERVICE_TYPE=File
WORKSPACE_MOUNT_PATH=                       # Ask User
LOCAL_ARTIFACT_PATH=.foundry/artifacts
DEFAULT_LLM_MODEL=gemini-3.7-flash
AGENT_BASE_URL=http://localhost:8080
PORT=8080

# API Service Configuration (api/)
API_PORT=8081
PERF_TEST_MODE=true
BMAD_ROOT_PATH=                             # Ask User

# UI Configuration (ui/)
WEB_PORT=8082

# Database & Cloud SQL Configuration
# --- Local Docker PostgreSQL (Default - Uses In-Memory sessions unless SESSION_SERVICE_TYPE=Database is set)
CLOUDSQL_CONNECTION_NAME=localhost:5432
CLOUDSQL_USER=apf-local-adk-user
CLOUDSQL_DATABASE=apf-local-session-db
CLOUDSQL_PASSWORD=apf-local-adk-password
SESSION_SERVICE_TYPE=Database

# External Integrations & Auth
GITHUB_ACCESS_TOKEN=                        # Ask User
DEV_REPO_ACCESS_TOKEN=                      # Ask User
SECRETS_ENCRYPTION_KEY=dev-32-bytes-secrets-key-apfninj

# Logging & Planning
LOG_LEVEL=DEBUG
DEBUG_MODE=true
SIMULATED_USER_ID=                          # Ask User

# Identity Access Management (Epic 11)
ENVIRONMENT=local
BYPASS_IAP_VALIDATION=true
PERF_TEST_KEY=
JWT_SECRET=local-development-secret-key-32-chars-long
IAP_AUDIENCE=
SUPER_ADMIN_EMAILS=                         # Ask User
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:8085

# Next.js UI Mock Auth Mode & Firebase Emulator Client Config
NEXT_PUBLIC_ENABLE_MOCK_AUTH=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:8085
NEXT_PUBLIC_FIREBASE_API_KEY=local-mock-api-key-for-emulator-boot
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=local-testing-mock-project